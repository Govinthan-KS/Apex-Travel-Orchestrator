# ============================================================
# Apex Travel Orchestrator — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env.local
#   # then edit .env.local with your real keys
#
# For Vercel deployment: add all variables in the Vercel
# project dashboard under Settings -> Environment Variables.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Get from: https://cloud.mongodb.com -> Clusters -> Connect
# -> Drivers -> Connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=YourApp

# ── Google OAuth ─────────────────────────────────────────────
# Google OAuth 2.0 credentials for sign-in.
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID (Web application type).
#
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google   (local dev)
#   https://your-app.vercel.app/api/auth/callback/google   (production)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your_google_client_secret

# ── Auth.js ──────────────────────────────────────────────────
# Secret used to sign and encrypt Auth.js session tokens.
# MUST be a cryptographically random string.
# Generate with: openssl rand -hex 32
#             or: npx auth secret
AUTH_SECRET=your_64_char_hex_secret_here

# ── Internal Security ────────────────────────────────────────
# Shared HMAC-SHA256 secret for verifying DNA payloads sent
# from this frontend to the Python backend.
# This MUST match INTERNAL_SHARED_SECRET in backend/.env.
# Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=your_shared_secret_here_min_32_hex_chars

# ── Backend Connection ────────────────────────────────────────
# URL of the deployed FastAPI backend.
# This variable is baked into the client bundle at build time
# (NEXT_PUBLIC_ prefix). It must be set correctly before running
# `next build` or deploying to Vercel.
#
# Local development: http://localhost:8000
# Production (Render example): https://your-backend.onrender.com
#
# IMPORTANT: If this is not set, the dashboard will silently call
# http://localhost:8000 in production and every planTrip() call
# will fail with a network error.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
