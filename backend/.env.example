# ============================================================
# Apex Travel Orchestrator — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real keys
# ============================================================

# ── AI / LLM ────────────────────────────────────────────────
# Groq API key for Llama 3.3 70B inference.
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# ── Flight Data ──────────────────────────────────────────────
# AviationStack API key for live flight data.
# Free tier: 100 requests/month. Get from: https://aviationstack.com/dashboard
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# ── Attraction Data ──────────────────────────────────────────
# OpenTripMap API key for points of interest.
# Free tier available. Get from: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# ── Web Search Fallback ──────────────────────────────────────
# Tavily API key — used when primary flight data is unavailable.
# Get from: https://app.tavily.com/home
TAVILY_API_KEY=tvly-your_tavily_key_here

# ── Vector Memory (Pinecone) ─────────────────────────────────
# Pinecone API key for semantic user memory storage.
# Get from: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=pcsk_your_pinecone_key_here

# Name of the Pinecone index to use.
# Must be a 384-dimension cosine similarity index.
# Create at: https://app.pinecone.io -> Indexes -> Create Index
# Recommended name: apex-user-memory
PINECONE_INDEX_NAME=apex-user-memory

# ── Embeddings ───────────────────────────────────────────────
# HuggingFace API key for generating 384-dim embeddings
# via the all-MiniLM-L6-v2 model (Inference API).
# Get from: https://huggingface.co/settings/tokens
# Required scope: Inference API (read)
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here

# ── Internal Security ────────────────────────────────────────
# Shared secret for HMAC-SHA256 signature verification.
# This MUST match INTERNAL_SHARED_SECRET in frontend/.env.local.
# Generate a new value with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=your_shared_secret_here_min_32_hex_chars

# ── CORS ─────────────────────────────────────────────────────
# The URL of your deployed Next.js frontend.
# Used to configure CORS allowed origins.
# Local development: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
